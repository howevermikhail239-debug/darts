#!/usr/bin/env bash
set -euo pipefail

# The path is fixed in production; the override exists so the script can be exercised in tests.
data_dir="${DARTS_BACKUP_DATA_DIR:-/var/lib/dart-scorekeeper}"
backup_dir="$data_dir/backups"
source_file="$data_dir/dart-scorekeeper.json"

# Tiered retention: the newest hourly copies, then one per day, then one per month.
keep_recent=24
keep_daily=14
keep_monthly=6

install -d -m 0750 "$backup_dir"
[[ -f "$source_file" ]] || exit 0

# The validator lives next to the installed script, in the release tree, or is named explicitly.
validator=""
for candidate in \
  "${DARTS_VALIDATOR:-}" \
  /usr/local/lib/dart-scorekeeper/validate-storage.mjs \
  /opt/dart-scorekeeper/current/deployment/yandex/validate-storage.mjs \
  "$(dirname "$(readlink -f "$0")")/validate-storage.mjs"
do
  [[ -n "$candidate" && -f "$candidate" ]] || continue
  validator="$candidate"
  break
done
if [[ -z "$validator" ]]; then
  echo "dart-scorekeeper-backup: validate-storage.mjs not found, refusing to take an unchecked backup" >&2
  exit 1
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
temporary_file="$(mktemp "$backup_dir/.dart-scorekeeper-$timestamp.XXXXXX.tmp")"
backup_file="$backup_dir/dart-scorekeeper-$timestamp.json"
trap 'rm -f "$temporary_file" "$temporary_file.sha256"' EXIT
cp --preserve=mode,ownership,timestamps "$source_file" "$temporary_file"

# A corrupt snapshot must never displace the good copies that are still on disk.
if ! node "$validator" "$temporary_file" >/dev/null; then
  echo "dart-scorekeeper-backup: storage validation failed, backup rejected" >&2
  exit 1
fi

checksum="$(sha256sum "$temporary_file" | cut -d' ' -f1)"
mv "$temporary_file" "$backup_file"
trap - EXIT
# Written so that `cd "$backup_dir" && sha256sum -c dart-scorekeeper-<stamp>.json.sha256` verifies it.
printf '%s  %s\n' "$checksum" "$(basename "$backup_file")" >"$backup_file.sha256"
chmod 0640 "$backup_file.sha256"

declare -A keep=()
declare -A seen_day=()
declare -A seen_month=()
index=0

while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  stamp="${name#dart-scorekeeper-}"
  stamp="${stamp%.json}"
  [[ "$stamp" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || { keep["$name"]=1; continue; }
  day="${stamp:0:8}"
  month="${stamp:0:6}"
  if (( index < keep_recent )); then
    keep["$name"]=1
  fi
  if [[ -z "${seen_day[$day]:-}" && ${#seen_day[@]} -lt $keep_daily ]]; then
    seen_day[$day]=1
    keep["$name"]=1
  fi
  if [[ -z "${seen_month[$month]:-}" && ${#seen_month[@]} -lt $keep_monthly ]]; then
    seen_month[$month]=1
    keep["$name"]=1
  fi
  index=$((index + 1))
done < <(find "$backup_dir" -maxdepth 1 -type f -name 'dart-scorekeeper-*.json' -printf '%f\n' | sort -r)

while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  [[ -z "${keep[$name]:-}" ]] || continue
  rm -f -- "$backup_dir/$name" "$backup_dir/$name.sha256"
done < <(find "$backup_dir" -maxdepth 1 -type f -name 'dart-scorekeeper-*.json' -printf '%f\n')

# Checksums whose backup is gone are removed as well.
while IFS= read -r name; do
  [[ -n "$name" ]] || continue
  [[ -f "$backup_dir/${name%.sha256}" ]] || rm -f -- "$backup_dir/$name"
done < <(find "$backup_dir" -maxdepth 1 -type f -name 'dart-scorekeeper-*.json.sha256' -printf '%f\n')
